# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채우세요.
# .env.local 은 .gitignore 에 포함되어 커밋되지 않습니다.
#
#   copy .env.example .env.local     (Windows cmd)

# Supabase 프로젝트 URL. NEXT_PUBLIC_ 접두사가 붙어 브라우저 번들에 인라인되지만,
# URL 자체는 비밀이 아니므로 무방합니다.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# anon 키 — 로그인/세션 확인 전용. 브라우저에 노출되어도 됩니다.
# 0001_init.sql 에서 정책 없이 RLS 를 켜뒀기 때문에, 이 키로는 users /
# attendance_logs / anti_spoof_logs 어느 것도 읽을 수 없습니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role 키 — RLS 를 우회하는 마스터 키입니다.
#
# 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요. 붙이는 순간 브라우저 번들에 들어가고,
# 그 키를 가진 사람은 등록자 전원의 얼굴 생체정보를 조회할 수 있습니다.
# Supabase 대시보드 → Project Settings → API 에서 확인합니다.
SUPABASE_SERVICE_ROLE_KEY=

# DeepFace 서버 주소 (기본값 http://localhost:5005/represent-liveness).
# 별도 호스트에 띄운 경우에만 설정하세요.
# DEEPFACE_API_URL=
