# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채우세요.
# .env.local 은 .gitignore 에 포함되어 커밋되지 않습니다.
#
#   copy .env.example .env.local     (Windows cmd)

# Supabase 프로젝트 URL. NEXT_PUBLIC_ 접두사가 붙어 브라우저 번들에 인라인되지만,
# URL 자체는 비밀이 아니므로 무방합니다.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# anon 키 — 로그인/세션 확인 전용. 브라우저에 노출되어도 됩니다.
# 0001_init.sql 에서 정책 없이 RLS 를 켜뒀기 때문에, 이 키로는 users /
# attendance_logs / anti_spoof_logs 어느 것도 읽을 수 없습니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role 키 — RLS 를 우회하는 마스터 키입니다.
#
# 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요. 붙이는 순간 브라우저 번들에 들어가고,
# 그 키를 가진 사람은 등록자 전원의 얼굴 생체정보를 조회할 수 있습니다.
# Supabase 대시보드 → Project Settings → API 에서 확인합니다.
SUPABASE_SERVICE_ROLE_KEY=

# 매칭 증표(match token) 서명 키. 32자 이상이어야 하고, 기본값은 없습니다.
#
# /api/match 가 매칭 성공 시 이 키로 서명한 증표를 발급하고, POST /api/attendance 가
# 그 서명을 검증합니다. 이게 없으면 userId 만 아는 사람이 얼굴 없이 출석을 위조할 수
# 있습니다(lib/matchToken.js 참고). 아래 명령으로 만드세요:
#
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
ATTENDANCE_TOKEN_SECRET=

# DeepFace 서버 주소 (기본값 http://localhost:5005/represent-liveness).
# 로컬에서 파이썬 서버를 직접 띄우면 설정하지 않아도 됩니다.
#
# 배포 시에는 반드시 설정해야 합니다. 배포된 서버에서 localhost 는 "서버 자기 자신" 을
# 가리키므로 절대 연결되지 않습니다. 자세한 절차는 deepface-api/DEPLOY.md 참고.
# DEEPFACE_API_URL=https://<사용자명>-facegate-deepface.hf.space/represent-liveness

# 얼굴 인식 서버 인증 키. 서버 쪽 DEEPFACE_API_KEY 와 같은 값이어야 합니다.
# 서버를 인터넷에 올리면 주소를 아는 누구나 호출할 수 있으므로, 공개 배포 시 필수입니다.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# DEEPFACE_API_KEY=
