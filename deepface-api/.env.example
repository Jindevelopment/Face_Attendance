# deepface-api 환경변수 예시 (실제 사용 시 .env 로 복사)
DEEPFACE_HOST=0.0.0.0
DEEPFACE_PORT=5005

# 프리로드할 얼굴 인식 모델 (쉼표 구분). 512차원 임베딩 = Facenet512
DEEPFACE_FACE_RECOGNITION_MODELS=Facenet512

# 1 이면 서버 기동 시 MiniFASNet(Fasnet) 라이브니스 모델을 미리 로드
DEEPFACE_ANTI_SPOOFING=1

# 공유 인증 키. 설정하면 X-API-Key 헤더를 요구한다.
# Next.js 쪽 DEEPFACE_API_KEY 와 같은 값이어야 한다.
#
# 로컬 개발에서는 비워둬도 되지만, 인터넷에 올릴 때는 반드시 넣어야 한다.
# 넣지 않으면 주소를 아는 누구나 얼굴 이미지를 보내 분석시킬 수 있다.
# (Hugging Face Spaces 로 판단되면 키 없이는 모든 요청을 503 으로 거부한다.)
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# DEEPFACE_API_KEY=
